{
  "name": "@cbxss/vhs-rs",
  "version": "0.3.2",
  "description": "Script, test, and record real terminals. Screenshots, GIFs, replay, and TypeScript control.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "vhs-rs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "OFL.txt",
    "SYMBOLS-LICENSE.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "optionalDependencies": {
    "@cbxss/vhs-rs-linux-x64": "0.3.2",
    "@cbxss/vhs-rs-darwin-arm64": "0.3.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbxss/vhs-rs.git",
    "directory": "npm/vhs-rs"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/cbxss/vhs-rs#readme",
  "keywords": [
    "terminal",
    "automation",
    "cli",
    "tui",
    "testing",
    "gif",
    "screenshot",
    "typescript",
    "pty",
    "vhs"
  ]
}
